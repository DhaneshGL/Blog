# Copy this file to .env and fill in real values. Never commit the real .env.

# Django
DJANGO_SECRET_KEY=dain
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# MySQL (replaces MONGO=... from the original Node .env)
DB_NAME=blog
DB_USER=blog_user
DB_PASSWORD=dain
DB_HOST=localhost
DB_PORT=3306

# Same JWT_SECRET the Node app used - keep it identical if you want
# existing tokens/cookies issued by the old backend to keep working.
JWT_SECRET=dain

# Frontend origin(s) allowed to call this API with credentials,
# equivalent of process.env.CLIENT. Comma-separate multiple origins.
CLIENT=http://localhost:5173
